# Go (root-level binary only; must not match cmd/identityhub/)
/identityhub
/bin/
/dist/
*.test
*.out

# Go embed build output is generated by `npm run build`; keep a fallback index.html
# (uncomment to ignore generated assets)
# web/dist/*

# Frontend
web/node_modules/
web/dist-ssr/
*.local

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Test artifacts
coverage.out
coverage.html
web/playwright-report/
web/test-results/

# Local asset uploads (STORAGE_DIR default)
var/

# Python caches (vendored skill scripts)
__pycache__/
*.pyc

# TS build cache
web/*.tsbuildinfo
