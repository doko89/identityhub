# Copy to .env (never commit real secrets). All settings are env-only in v1.
APP_ENV=development
HTTP_PORT=8080
LOG_FORMAT=text

# pgx connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/identityhub?sslmode=disable

# Base64 of 32 random bytes. Generate: openssl rand -base64 32
ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Session timeouts (TECH_SPEC §8 defaults: 30m idle, 12h absolute).
SESSION_IDLE_TIMEOUT=30m
SESSION_LIFETIME=12h

# Worker pass interval.
WORKER_SYNC_INTERVAL=5m

# Public origin used to build emailed links (password reset).
APP_BASE_URL=http://localhost:8080

# --- Upstream LDAP directory (PRD §6.2). Unset LDAP_URL disables
# directory login, sync, and the admin connection test.
# LDAP_URL=ldap://dir.example.com:389   # or ldaps://...:636
# LDAP_BIND_DN=cn=svc,dc=example,dc=com
# LDAP_BIND_PASSWORD=change-me
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_FILTER=(department=IT)      # optional extra filter
# LDAP_GROUP_FILTER=                    # optional extra filter
# LDAP_ADMIN_GROUP_DN=cn=admins,ou=groups,dc=example,dc=com  # optional ih_admin mapping
# LDAP_TIMEOUT=10s
# LDAP_ATTR_MAP=department:dept,employeeID:employee-id  # optional
#   upstream-attribute:custom-key import; keys need a def (POST
#   /api/admin/user-attrs) or the values are skipped on sync.

# --- Transactional mail (password reset). Unset SMTP_HOST logs mail
# instead of delivering it (development default).
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USERNAME=idp
# SMTP_PASSWORD=change-me
# SMTP_FROM=idp@example.com

# --- LDAP provider: in-process server (TECH_SPEC §6.4). Unset LDAP_MODE
# disables the listener. Bind DN: uid=<username>,ou=users,dc=identityhub.
# LDAP_MODE=ldap            # ldap (plaintext) | ldaps | starttls
# LDAP_PORT=1389            # 389/636 are the standard ports (need root)
# LDAP_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16   # required for ldap mode;
#   enforced before any LDAP bytes are parsed. Optional in TLS modes.
# LDAP_TLS_CERT_FILE=/run/secrets/ldap.crt       # required for ldaps/starttls
# LDAP_TLS_KEY_FILE=/run/secrets/ldap.key        # TLS 1.2 minimum

# --- RADIUS provider: in-process PAP server (TECH_SPEC §6.5).
RADIUS_ENABLED=true
RADIUS_PORT=1812
# NAS devices register in radius_clients (nas_identifier = source IP,
# shared secret sealed with ENC_KEY); unknown NAS packets are dropped.

# --- Asset storage (TECH_SPEC §6.7). Local filesystem by default; s3
# (S3-compatible, minio-go) since M7. Endpoint is host[:port] without a
# scheme; the bucket must exist (checked at boot).
STORAGE_BACKEND=local
STORAGE_DIR=./var/uploads
# STORAGE_S3_ENDPOINT=s3.example.com
# STORAGE_S3_BUCKET=identityhub-assets
# STORAGE_S3_ACCESS_KEY=ak
# STORAGE_S3_SECRET_KEY=sk
# STORAGE_S3_USE_SSL=true

# Bootstrap admin password for `identityhub create-admin`
# (alternative to the --password flag; used once, then unset).
# IDENTITYHUB_ADMIN_PASSWORD=change-me-12-chars-min
