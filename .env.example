# Copy to .env (never commit real secrets). All settings are env-only in v1.
APP_ENV=development
HTTP_PORT=8080
LOG_FORMAT=text

# pgx connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/identityhub?sslmode=disable

# Base64 of 32 random bytes. Generate: openssl rand -base64 32
ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Session timeouts (TECH_SPEC §8 defaults: 30m idle, 12h absolute).
SESSION_IDLE_TIMEOUT=30m
SESSION_LIFETIME=12h

# Worker pass interval.
WORKER_SYNC_INTERVAL=5m

# Public origin used to build emailed links (password reset).
APP_BASE_URL=http://localhost:8080

# --- Upstream LDAP directory (PRD §6.2). Unset LDAP_URL disables
# directory login, sync, and the admin connection test.
# LDAP_URL=ldap://dir.example.com:389   # or ldaps://...:636
# LDAP_BIND_DN=cn=svc,dc=example,dc=com
# LDAP_BIND_PASSWORD=change-me
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_FILTER=(department=IT)      # optional extra filter
# LDAP_GROUP_FILTER=                    # optional extra filter
# LDAP_ADMIN_GROUP_DN=cn=admins,ou=groups,dc=example,dc=com  # optional ih_admin mapping
# LDAP_TIMEOUT=10s

# --- Transactional mail (password reset). Unset SMTP_HOST logs mail
# instead of delivering it (development default).
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USERNAME=idp
# SMTP_PASSWORD=change-me
# SMTP_FROM=idp@example.com

# Bootstrap admin password for `identityhub create-admin`
# (alternative to the --password flag; used once, then unset).
# IDENTITYHUB_ADMIN_PASSWORD=change-me-12-chars-min
