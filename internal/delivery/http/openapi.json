      "post": {
        "tags": ["mfa"],
        "summary": "Verify the second step (or a recovery code) after password login",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string" },
                  "recovery_code": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Full session" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
