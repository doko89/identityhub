      "get": {
        "tags": ["system"],
        "summary": "This documentation UI (admin only)",
        "responses": {
          "200": { "description": "HTML", "content": { "text/html": { "schema": { "type": "string" } } } },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/admin/docs/openapi.json": {
      "get": {
        "tags": ["system"],
        "summary": "This OpenAPI document (admin only)",
        "responses": {
          "200": {
            "description": "OpenAPI JSON",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": { "type": "apiKey", "in": "cookie", "name": "ih_session", "description": "MFA-verified admin session cookie from POST /api/auth/login (+ MFA step)" },
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "Personal API key owned by an ih_admin member, created from an MFA-verified session" }
    },
    "parameters": {
      "Limit": { "name": "limit", "in": "query", "schema": { "type": "integer" } },
      "Offset": { "name": "offset", "in": "query", "schema": { "type": "integer" } },
      "UserId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "GroupId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "AppId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid auth",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Forbidden": {
        "description": "Not an admin, or MFA step-up required (mfa_required)",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "No such object",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RateLimited": {
        "description": "Too many attempts",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "email": { "type": "string" },
          "display_name": { "type": "string" },
          "avatar_url": { "type": "string" },
          "is_active": { "type": "boolean" },
          "is_admin": { "type": "boolean" },
          "source": { "type": "string" },
          "groups": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "AttrDef": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string", "enum": ["string", "number", "boolean"] },
          "multi": { "type": "boolean" }
        }
      },
      "App": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "slug": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "launch_url": { "type": "string" },
          "group_label": { "type": "string" },
          "provider_type": { "type": "string" },
          "is_visible": { "type": "boolean" }
        }
      },
      "Binding": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "binding_type": { "type": "string" },
          "user_id": { "type": "string" },
          "group_id": { "type": "string" },
          "effect": { "type": "string" }
        }
      },
      "OIDCClient": {
        "type": "object",
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "client_id": { "type": "string" },
          "redirect_uris": { "type": "array", "items": { "type": "string" } },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "public": { "type": "boolean" }
        }
      },
      "SAMLSP": {
        "type": "object",
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "entity_id": { "type": "string" },
          "acs_url": { "type": "string" },
          "slo_url": { "type": "string" },
          "name_id": { "type": "string" }
        }
      },
      "RADIUSClient": {
        "type": "object",
        "properties": {
          "application_id": { "type": "string", "format": "uuid" },
          "nas_identifier": { "type": "string" }
        }
      }
    }
  }
}
